# Copy to config.yaml and fill in from `bbctl register sh-zalo` output.
matrix:
  homeserverUrl: https://matrix.beeper.com/_hungryserv/<your-beeper-username>
  domain: beeper.local
  registrationPath: registration.yaml
  # Must match the `url:` port inside registration.yaml (bbctl proxy target)
  port: 29350
  # Your Beeper Matrix ID — only this user may issue bot commands
  owner: "@<your-beeper-username>:beeper.com"

zalo:
  # zca-js session credentials (auto-created on QR login; chmod 600; NEVER commit)
  credsPath: zalo-creds.session.json
  # Conservative outbound pacing to protect the Zalo account
  messagesPerMinute: 8

logging:
  level: info

bridge:
  # SQLite mapping store (portal rooms, ghosts, message dedup)
  dbPath: bridge.db
  # Inbound media size cap in bytes (default 10MB)
  mediaMaxBytes: 10485760
